{
  "name": "ian-wangsa-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "node ./node_modules/next/dist/bin/next build",
    "preview": "python3 -m http.server 8766 --bind 127.0.0.1 --directory out",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check:skills": "node scripts/check-skill-physics.mjs",
    "check:interactions": "node --experimental-strip-types --test tests/*.test.mjs && node scripts/check-builder-journey.mjs",
    "check:assets": "node scripts/check-site-assets.mjs",
    "check": "npm run typecheck && npm run check:interactions && npm run check:skills && npm run build && npm run check:assets"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "framer-motion": "^14.5.0",
    "lucide-react": "^1.61.0",
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "postcss": "^8.5.6",
    "typescript": "~5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/matter-js": "^0.20.2"
  }
}
